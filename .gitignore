# Godot 4 — import cache & editor-generated data (regenerated automatically on open)
/.godot/

# macOS
.DS_Store

# Meshy download intermediates — the model the game actually uses is
# assets/models/hero_anim_merged.glb; these are just the raw bundle/extraction.
/assets/models/*.zip
/assets/models/hero_animated/
/assets/models/nm_extract/
/assets/models/hero_character.glb

# Raw Meshy gun exports (90-130 MB each, 4K textures — one is over GitHub's
# 100 MB hard limit). Only the shrunk gun_*.glb are committed; regenerate with
#   python3 tools/shrink_glb_textures.py <raw>.glb assets/models/gun_<name>.glb --max 1024
# (covers the .glb, its .import, and the 4K textures Godot extracts beside it)
/assets/models/gun-*-model*
/assets/models/ammo-crate-*
/assets/models/scifi-ammo-crate-*
# Raw Meshy city buildings: 25-71 MB each with 4K textures. Shrink them with
#   python3 tools/shrink_glb_textures.py <raw>.glb assets/models/<name>.glb --max 1024
# and commit THAT, the way the guns and the ammo crate were done.
/assets/models/city-building-*
/assets/models/charlies-*
