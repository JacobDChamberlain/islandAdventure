; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Island Adventure (Prototype)"
config/description="A 3D platformer / collectathon prototype in the spirit of Jak & Daxter."
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/game.gd"
Fx="*res://scripts/fx.gd"
Sfx="*res://scripts/sfx.gd"
Settings="*res://scripts/settings.gd"
SaveManager="*res://scripts/save_manager.gd"
Dialogue="*res://scenes/dialogue.tscn"
DebugMenu="*res://scenes/debug_menu.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

rendering_device/driver.macos="vulkan"

; Forward+ does not exist on the web -- it needs Vulkan, which browsers do not
; expose -- so the web build runs the Compatibility (WebGL2) renderer. This is a
; per-platform override, so desktop keeps Forward+ and the Metal->Vulkan fix
; above. Consequences to expect in a browser: SSAO is Forward+ only and is
; silently ignored, and shadows and glow differ. Test the web build on its own
; terms rather than assuming it matches desktop.
renderer/rendering_method.web="gl_compatibility"
